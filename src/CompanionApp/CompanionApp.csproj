<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.26100.0</TargetPlatformMinVersion>
    <RootNamespace>ERechnung.CompanionApp</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>MSIX</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <DefaultLanguage>de-DE</DefaultLanguage>
    <EnableDefaultPriItems>false</EnableDefaultPriItems>
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
    <AppxBundle>Never</AppxBundle>
    <AppxSymbolPackageEnabled>false</AppxSymbolPackageEnabled>
    <GenerateTestArtifacts>true</GenerateTestArtifacts>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWinRT" Version="2.2.0" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.8249" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260804001" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../PrintCore/PrintCore.csproj" />
    <ProjectReference Include="../VirtualPrinter.Tasks/VirtualPrinter.Tasks.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\*.png" />
    <Content Include="Config\PrinterPdc.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Manifest Include="$(ApplicationManifest)" />
    <PRIResource Include="Strings\de-DE\Resources.resw" />
  </ItemGroup>

  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>

  <Target Name="IncludeTasksWinmd" AfterTargets="Build">
    <ItemGroup>
      <_TasksWinmdSource
        Include="..\VirtualPrinter.Tasks\bin\$(Platform)\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\VirtualPrinter.Tasks.winmd"
        Condition="Exists('..\VirtualPrinter.Tasks\bin\$(Platform)\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\VirtualPrinter.Tasks.winmd')" />
      <_TasksWinmdSource
        Include="..\VirtualPrinter.Tasks\bin\$(Platform)\$(Configuration)\$(TargetFramework)\VirtualPrinter.Tasks.winmd"
        Condition="'@(_TasksWinmdSource)' == '' and Exists('..\VirtualPrinter.Tasks\bin\$(Platform)\$(Configuration)\$(TargetFramework)\VirtualPrinter.Tasks.winmd')" />
    </ItemGroup>
    <Copy
      SourceFiles="@(_TasksWinmdSource)"
      DestinationFolder="$(OutputPath)"
      SkipUnchangedFiles="true"
      Condition="'@(_TasksWinmdSource)' != ''" />
    <Error
      Text="VirtualPrinter.Tasks.winmd wurde nicht erzeugt. Background-Task kann nicht registriert werden."
      Condition="'@(_TasksWinmdSource)' == ''" />
  </Target>
</Project>
