<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.26100.0</TargetPlatformMinVersion>
    <RootNamespace>ERechnung.CompanionApp</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>MSIX</WindowsPackageType>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <NativePrinterTaskPath>$(MSBuildThisFileDirectory)..\..\..\artifacts\printer-native\$(RuntimeIdentifier)\ERechnung.VirtualPrinter.Tasks.dll</NativePrinterTaskPath>
    <DefaultLanguage>de-DE</DefaultLanguage>
    <EnableDefaultPriItems>false</EnableDefaultPriItems>
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
    <AppxBundle>Never</AppxBundle>
    <AppxSymbolPackageEnabled>false</AppxSymbolPackageEnabled>
    <GenerateTestArtifacts>true</GenerateTestArtifacts>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWinRT" Version="2.3.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.8249" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260804001" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../PrintCore/PrintCore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\*.png" />
    <Content Include="$(NativePrinterTaskPath)" Link="ERechnung.VirtualPrinter.Native.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="$([System.IO.Path]::ChangeExtension('$(NativePrinterTaskPath)', '.winmd'))" Link="ERechnung.VirtualPrinter.Tasks.winmd">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Config\PrinterPdc.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Manifest Include="$(ApplicationManifest)" />
    <PRIResource Include="Strings\de-DE\Resources.resw" />
  </ItemGroup>

  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>

  <Target Name="IncludeTasksWinmd" AfterTargets="Build">
    <Error Condition="!Exists('$(NativePrinterTaskPath)')" Text="Der native Drucker-Task fehlt. Zuerst printer/scripts/build-native-task.ps1 ausführen." />
  </Target>
</Project>
