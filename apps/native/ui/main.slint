import { AboutSlint, Button, ComboBox, LineEdit, Palette, ScrollView, TabWidget, TextEdit, VerticalBox, HorizontalBox } from "std-widgets.slint";

export global OutputState {
    in-out property <bool> can-email: false;
    in-out property <bool> busy: false;
}

component LabeledField inherits HorizontalBox {
    in property <string> label;
    in-out property <string> value <=> input.text;
    spacing: 8px;
    Text { text: root.label; width: 150px; vertical-alignment: center; }
    input := LineEdit {
        horizontal-stretch: 1;
        enabled: !OutputState.busy;
        edited => { OutputState.can-email = false; }
    }
}

export component MainWindow inherits Window {
    in-out property <int> appearance: 0;
    callback appearance-changed();
    changed appearance => {
        Palette.color-scheme = root.appearance == 1 ? ColorScheme.light : root.appearance == 2 ? ColorScheme.dark : ColorScheme.unknown;
        root.appearance-changed();
    }
    init => { Palette.color-scheme = ColorScheme.unknown; }
    title: "Druckwandel";
    preferred-width: 1320px;
    preferred-height: 760px;
    background: Palette.background;
    icon: @image-url("../assets/app-icon.svg");
    min-width: 1200px;
    min-height: 650px;

    in property <[string]> documents;
    in property <[string]> line-labels;
    in-out property <int> selected-line: 0;
    in property <string> selected-name;
    in property <string> selected-path;
    in property <string> selected-hash;
    in property <string> source-text;
    in property <bool> source-has-xml;
    in property <string> recognition-text;
    in-out property <int> recognition-method: 0;
    in-out property <int> output-format: 0;
    callback recognize();
    in property <string> status-text;
    in-out property <string> invoice-number;
    in-out property <string> issue-date;
    in-out property <string> due-date;
    in-out property <string> buyer-reference;
    in-out property <string> seller-name;
    in-out property <string> seller-street;
    in-out property <string> seller-postal;
    in-out property <string> seller-city;
    in-out property <string> seller-country;
    in-out property <string> seller-vat;
    in-out property <string> seller-endpoint;
    in-out property <string> seller-contact-name;
    in-out property <string> seller-contact-phone;
    in-out property <string> seller-contact-email;
    in-out property <string> buyer-name;
    in-out property <string> buyer-street;
    in-out property <string> buyer-postal;
    in-out property <string> buyer-city;
    in-out property <string> buyer-country;
    in-out property <string> buyer-endpoint;
    in-out property <string> line-name;
    in-out property <string> line-quantity;
    in-out property <string> line-price;
    in-out property <string> line-tax-rate;
    in-out property <string> payment-iban;
    private property <bool> show-settings: false;
    out property <bool> settings-open: root.show-settings;
    in property <image> preview-image;
    in property <float> preview-aspect: 1.414;
    in-out property <int> preview-page: 0;
    in property <int> preview-page-count: 0;
    in property <bool> preview-loading: false;
    in property <string> preview-error;
    in-out property <int> preview-zoom: 0;
    private property <float> preview-zoom-factor: root.preview-zoom == 1 ? 1.25 : root.preview-zoom == 2 ? 1.5 : root.preview-zoom == 3 ? 2 : 1;
    private property <length> preview-offset-x: 0px;
    private property <length> preview-offset-y: 0px;
    callback request-preview();
    changed selected-path => { root.preview-page = 0; root.preview-offset-x = 0px; root.preview-offset-y = 0px; root.request-preview(); }
    changed selected-hash => { root.request-preview(); }
    changed preview-page => { root.preview-offset-x = 0px; root.preview-offset-y = 0px; root.request-preview(); }
    changed preview-zoom => { root.preview-offset-x = 0px; root.preview-offset-y = 0px; root.request-preview(); }
    private property <bool> show-pdf-text: false;
    callback import-pdf();
    callback open-source();
    callback import-print-job();
    callback select-document(int);
    callback save-draft();
    callback save-xml();
    callback send-email();
    callback select-line(int);
    callback add-line();
    callback remove-line();

    VerticalBox {
        padding: 20px;
        spacing: 16px;

        HorizontalBox {
            spacing: 16px;
            Image { source: @image-url("../assets/app-icon.svg"); width: 40px; height: 40px; image-fit: contain; }
            Rectangle { horizontal-stretch: 1; background: transparent; }

            Button { text: "Entwurf speichern"; enabled: root.selected-name != "" && !OutputState.busy; clicked => { root.save-draft(); } }
            Button { text: "Prüfen und speichern"; enabled: root.selected-name != "" && !OutputState.busy; clicked => { root.save-xml(); } }
            Button { text: "Per E-Mail senden"; enabled: OutputState.can-email && !OutputState.busy; clicked => { root.send-email(); } }
            Button {
                icon: @image-url("../assets/settings.svg");
                icon-size: 20px;
                colorize-icon: true;
                height: 40px;
                accessible-label: "Einstellungen";
                width: 40px;
                clicked => { root.show-settings = !root.show-settings; }
            }
        }

        if root.show-settings : Rectangle {
            background: Palette.alternate-background;
            border-radius: 8px;
            vertical-stretch: 1;
            VerticalBox {
                padding: 24px;
                spacing: 16px;
                alignment: start;
                HorizontalBox {
                    Text { text: "Einstellungen"; font-size: 22px; font-weight: 600; horizontal-stretch: 1; }
                    Button { text: "Zurück zur Rechnung"; clicked => { root.show-settings = false; } }
                }
                HorizontalBox {
                    Text { text: "Darstellung"; vertical-alignment: center; }
                    ComboBox { width: 180px; model: ["System", "Hell", "Dunkel"]; current-index <=> root.appearance; }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                }
                Text { text: "Über Druckwandel"; font-size: 18px; font-weight: 600; }
                Text { text: "Version 0.4.0 (in Entwicklung)"; }
                AboutSlint { max-width: 420px; max-height: 220px; }
            }
        }

        if !root.show-settings : HorizontalBox {
            spacing: 16px;
            Rectangle {
                width: 220px;
                background: Palette.alternate-background;
                border-radius: 8px;
                VerticalBox {
                    padding: 12px;
                    spacing: 8px;
                    Button { text: "Neue PDF öffnen"; enabled: !OutputState.busy; clicked => { root.import-pdf(); } }
                    Button { text: "Druckeingang"; enabled: !OutputState.busy; clicked => { root.import-print-job(); } }
                    Text { text: "Entwürfe"; font-size: 18px; font-weight: 600; }
                    ScrollView {
                        vertical-stretch: 1;
                        VerticalBox {
                            alignment: start;
                            spacing: 4px;
                            for document[index] in root.documents : Button {
                                text: document;
                                height: 36px;
                                enabled: !OutputState.busy; clicked => { root.select-document(index); }
                            }
                        }
                    }
                }
            }
            if root.selected-name == "" : Rectangle {
                background: Palette.alternate-background;
                border-radius: 8px;
                horizontal-stretch: 1;
                VerticalBox {
                    padding: 32px;
                    alignment: center;
                    spacing: 18px;
                    Text { text: "Rechnung öffnen und prüfen"; font-size: 24px; font-weight: 600; }
                    Text { text: "1. Links eine neue PDF öffnen oder einen Entwurf auswählen.\n2. Erkannte Rechnungsdaten mit dem Original vergleichen.\n3. Ausgabe prüfen, speichern und per E-Mail teilen."; wrap: word-wrap; }
                }
            }
            if root.selected-name != "" : Rectangle {
                width: 500px;
                horizontal-stretch: 1;
                background: Palette.alternate-background;
                border-radius: 8px;
                VerticalBox {
                    padding: 12px;
                    spacing: 8px;
                    Text { text: root.selected-name; font-size: 18px; font-weight: 600; wrap: word-wrap; }
                    TabWidget {
                        vertical-stretch: 1;
                        Tab {
                            title: "PDF-Vorschau";
                            VerticalBox {
                                spacing: 8px;
                                HorizontalBox {
                                    Button { text: "‹"; accessible-label: "Vorherige Seite"; enabled: root.preview-page > 0; clicked => { root.preview-page -= 1; } }
                                    Text { text: root.preview-page-count > 0 ? "Seite " + (root.preview-page + 1) + " / " + root.preview-page-count : "PDF"; vertical-alignment: center; }
                                    Button { text: "›"; accessible-label: "Nächste Seite"; enabled: root.preview-page + 1 < root.preview-page-count; clicked => { root.preview-page += 1; } }
                                    ComboBox { model: ["Seitenbreite", "125 %", "150 %", "200 %"]; current-index <=> root.preview-zoom; }
                                }
                                if root.preview-loading : Text { text: "Seite wird gerendert …"; }
                                if root.preview-error != "" : Text { text: root.preview-error; wrap: word-wrap; }
                                preview-scroll := ScrollView {
                                    vertical-stretch: 1;
                                    viewport-x <=> root.preview-offset-x;
                                    viewport-y <=> root.preview-offset-y;
                                    viewport-width: max(self.visible-width, page-image.width + 16px);
                                    viewport-height: page-image.height + 16px;
                                    Rectangle {
                                        x: 0px; y: 0px;
                                        width: preview-scroll.viewport-width;
                                        height: preview-scroll.viewport-height;
                                        background: #686b70;
                                        page-image := Image {
                                            x: 8px; y: 8px;
                                            width: max(100px, (preview-scroll.visible-width - 16px) * root.preview-zoom-factor);
                                            height: self.width * root.preview-aspect;
                                            source: root.preview-image;
                                            image-fit: contain;
                                            accessible-label: "Gerenderte Original-PDF, Seite " + (root.preview-page + 1);
                                        }
                                    }
                                }
                                Button { text: "Im PDF-Programm öffnen"; clicked => { root.open-source(); } }
                            }
                        }
                        Tab {
                            title: "Erkennung";
                            VerticalBox {
                                spacing: 10px;
                                if root.source-has-xml : Text {
                                    text: "ZUGFeRD-XML vorhanden. Der aktuelle Import übernimmt nur PDF-Textvorschläge, noch nicht die eingebetteten Rechnungsdaten.";
                                    wrap: word-wrap;
                                }
                                ComboBox { model: ["Schemaerkennung", "Lokale KI (noch nicht installiert)"]; current-index <=> root.recognition-method; enabled: !OutputState.busy; }
                                Button { text: "Fehlende Felder erkennen"; enabled: !OutputState.busy; clicked => { root.recognize(); } }
                                TextEdit { text: root.recognition-text; read-only: true; vertical-stretch: 1; }
                                Button { text: root.show-pdf-text ? "PDF-Text ausblenden" : "PDF-Text anzeigen"; clicked => { root.show-pdf-text = !root.show-pdf-text; } }
                                if root.show-pdf-text : TextEdit { text: root.source-text; read-only: true; vertical-stretch: 1; }
                            }
                        }
                    }
                }
            }
            if root.selected-name != "" : Rectangle {
                background: Palette.alternate-background;
                border-radius: 8px;
                horizontal-stretch: 1;
                ScrollView {
                    VerticalBox {
                        padding: 16px;
                        spacing: 8px;
                        ComboBox { model: ["XRechnung (XML)", "ZUGFeRD (PDF)"]; current-index <=> root.output-format; enabled: !OutputState.busy; selected => { OutputState.can-email = false; } }
                        Text { text: "Rechnungsdaten"; font-size: 20px; font-weight: 600; }
                        LabeledField { label: "Rechnungsnummer"; value <=> root.invoice-number; }
                        LabeledField { label: "Rechnungsdatum"; value <=> root.issue-date; }
                        LabeledField { label: "Fälligkeit"; value <=> root.due-date; }
                        LabeledField { label: "Leitweg-ID/Referenz"; value <=> root.buyer-reference; }
                        Text { text: "Absender"; font-size: 16px; font-weight: 600; }
                        LabeledField { label: "Name"; value <=> root.seller-name; }
                        LabeledField { label: "Straße"; value <=> root.seller-street; }
                        LabeledField { label: "PLZ"; value <=> root.seller-postal; }
                        LabeledField { label: "Ort"; value <=> root.seller-city; }
                        LabeledField { label: "Land (ISO)"; value <=> root.seller-country; }
                        LabeledField { label: "USt-ID"; value <=> root.seller-vat; }
                        LabeledField { label: "E-Adresse"; value <=> root.seller-endpoint; }
                        LabeledField { label: "Kontakt"; value <=> root.seller-contact-name; }
                        LabeledField { label: "Telefon"; value <=> root.seller-contact-phone; }
                        LabeledField { label: "E-Mail"; value <=> root.seller-contact-email; }
                        Text { text: "Empfänger"; font-size: 16px; font-weight: 600; }
                        LabeledField { label: "Name"; value <=> root.buyer-name; }
                        LabeledField { label: "Straße"; value <=> root.buyer-street; }
                        LabeledField { label: "PLZ"; value <=> root.buyer-postal; }
                        LabeledField { label: "Ort"; value <=> root.buyer-city; }
                        LabeledField { label: "Land (ISO)"; value <=> root.buyer-country; }
                        LabeledField { label: "E-Adresse"; value <=> root.buyer-endpoint; }
                        HorizontalBox {
                            spacing: 8px;
                            Text { text: "Positionen"; font-size: 16px; font-weight: 600; horizontal-stretch: 1; }
                            Button { text: "+"; enabled: root.selected-name != "" && !OutputState.busy; clicked => { root.add-line(); } }
                            Button { text: "−"; enabled: root.selected-name != "" && root.line-labels.length > 1 && !OutputState.busy; clicked => { root.remove-line(); } }
                        }
                        HorizontalBox {
                            spacing: 4px;
                            for line[index] in root.line-labels : Button {
                                text: line;
                                enabled: !OutputState.busy; clicked => { root.select-line(index); }
                            }
                        }
                        LabeledField { label: "Bezeichnung"; value <=> root.line-name; }
                        LabeledField { label: "Menge"; value <=> root.line-quantity; }
                        LabeledField { label: "Nettopreis"; value <=> root.line-price; }
                        LabeledField { label: "USt-Satz %"; value <=> root.line-tax-rate; }
                        Text { text: "Zahlung"; font-size: 16px; font-weight: 600; }
                        LabeledField { label: "IBAN"; value <=> root.payment-iban; }
                    }
                }
            }
        }

        Text {
            text: root.status-text;
            color: Palette.foreground;
            wrap: word-wrap;
        }
    }
}
