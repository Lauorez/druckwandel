import { AboutSlint, CheckBox, ComboBox, LineEdit, Palette, ScrollView, TabWidget, TextEdit, VerticalBox, HorizontalBox } from "std-widgets.slint";
import { ActionButton } from "action-button.slint";

export global OutputState {
    in-out property <bool> can-email: false;
    in-out property <bool> busy: false;
}

export global FieldRules {
    pure callback is-blank(string) -> bool;
}

component LabeledField inherits HorizontalBox {
    callback edited();
    in property <string> label;
    in property <bool> required: false;
    private property <bool> missing: root.required && FieldRules.is-blank(root.value);
    in-out property <string> value <=> input.text;
    padding: 0px;
    vertical-stretch: 0;
    spacing: 8px;
    Text {
        text: root.label + (root.required ? " *" : "");
        color: root.missing ? #d54444 : Palette.foreground;
        width: 155px; vertical-alignment: center;
    }
    Rectangle {
        horizontal-stretch: 1; min-height: 36px;
        border-width: root.missing ? 2px : 0px;
        border-color: #d54444; border-radius: 5px;
        background: transparent;
        input := LineEdit {
            x: 2px; y: 2px; width: parent.width - 4px; height: parent.height - 4px;
            accessible-label: root.label + (root.missing ? ", Pflichtfeld fehlt" : "");
            enabled: !OutputState.busy;
            edited => { OutputState.can-email = false; root.edited(); }
        }
    }
}


export struct AdjustmentData {
    charge: bool, amount: string, reason: string, reason-code: string,
    percent: string, base-amount: string, tax-category: string, tax-rate: string,
    tax-reason: string, tax-reason-code: string,
}
export struct LearningRuleData { id: string, label: string, enabled: bool }
export struct ReferenceData { number: string, date: string, paid: string }
export struct DraftEntry { id: string, name: string }

component TaxFields inherits VerticalBox {
    callback edited();
    in-out property <string> category;
    in-out property <string> rate;
    in-out property <string> reason;
    in-out property <string> reason-code;
    padding: 0px; spacing: 8px;
    ComboBox {
        model: ["S – Regelbesteuerung", "Z – Nullsteuersatz", "E – Steuerbefreit", "AE – Reverse Charge", "K – Innergemeinschaftlich"];
        current-index: root.category == "S" ? 0 : root.category == "Z" ? 1 : root.category == "E" ? 2 : root.category == "AE" ? 3 : root.category == "K" ? 4 : -1;
        enabled: !OutputState.busy;
        selected => {
            root.category = self.current-index == 0 ? "S" : self.current-index == 1 ? "Z" : self.current-index == 2 ? "E" : self.current-index == 3 ? "AE" : "K";
            if root.category != "S" { root.rate = "0"; }
            if root.category == "S" && root.rate == "0" { root.rate = ""; }
            if root.category == "S" || root.category == "Z" { root.reason = ""; root.reason-code = ""; }
            OutputState.can-email = false; root.edited();
        }
    }
    LabeledField { label: "USt-Satz %"; value <=> root.rate; edited => { root.edited(); } required: true; }
    if root.category == "E" || root.category == "AE" || root.category == "K" : VerticalBox {
        padding: 0px; spacing: 8px;
        LabeledField { label: "Steuerbefreiung"; value <=> root.reason; edited => { root.edited(); } required: true; }
        LabeledField { label: "Befreiungscode"; value <=> root.reason-code; edited => { root.edited(); } }
    }
}

component AdjustmentEditor inherits Rectangle {
    in-out property <AdjustmentData> item;
    in property <bool> line-level: false;
    callback edited(AdjustmentData);
    callback remove();
    vertical-stretch: 0;
    background: Palette.background; border-radius: 6px;
    border-color: Palette.border; border-width: 1px;
    VerticalBox {
        padding: 10px; spacing: 8px;
        HorizontalBox {
            padding: 0px;
            ComboBox {
                horizontal-stretch: 1;
                model: ["Rabatt / Abschlag", "Zuschlag"];
                current-index: root.item.charge ? 1 : 0;
                enabled: !OutputState.busy;
                selected => { root.item.charge = self.current-index == 1; OutputState.can-email = false; root.edited(root.item); }
            }
            ActionButton { text: "Entfernen"; enabled: !OutputState.busy; clicked => { root.remove(); } }
        }
        LabeledField { label: "Nettobetrag"; value <=> root.item.amount; edited => { root.edited(root.item); } required: true; }
        LabeledField { label: "Begründung"; value <=> root.item.reason; edited => { root.edited(root.item); } required: FieldRules.is-blank(root.item.reason-code); }
        LabeledField { label: "Grundcode"; value <=> root.item.reason-code; edited => { root.edited(root.item); } }
        LabeledField { label: "Prozent (optional)"; value <=> root.item.percent; edited => { root.edited(root.item); } }
        LabeledField { label: "Basisbetrag"; value <=> root.item.base-amount; edited => { root.edited(root.item); } }
        if !root.line-level : TaxFields {
            category: root.item.tax-category; rate: root.item.tax-rate;
            reason: root.item.tax-reason; reason-code: root.item.tax-reason-code;
            edited => {
                root.item.tax-category = self.category; root.item.tax-rate = self.rate;
                root.item.tax-reason = self.reason; root.item.tax-reason-code = self.reason-code;
                root.edited(root.item);
            }
        }
    }
}

component ReferenceEditor inherits VerticalBox {
    in-out property <ReferenceData> item;
    callback edited(ReferenceData);
    callback remove();
    padding: 0px; spacing: 8px;
    LabeledField { label: "Rechnungsnummer"; value <=> root.item.number; required: true; edited => { root.edited(root.item); } }
    LabeledField { label: "Rechnungsdatum"; value <=> root.item.date; edited => { root.edited(root.item); } }
    LabeledField { label: "Gezahlter Betrag"; value <=> root.item.paid; edited => { root.edited(root.item); } }
    ActionButton { text: "Bezug entfernen"; enabled: !OutputState.busy; clicked => { root.remove(); } }
}

export component MainWindow inherits Window {
    in-out property <int> appearance: 0;
    callback appearance-changed();
    changed appearance => {
        Palette.color-scheme = root.appearance == 1 ? ColorScheme.light : root.appearance == 2 ? ColorScheme.dark : ColorScheme.unknown;
        root.appearance-changed();
    }
    init => { Palette.color-scheme = ColorScheme.unknown; }
    title: "Druckwandel";
    preferred-width: 1320px;
    preferred-height: 760px;
    default-font-size: 14px;
    background: Palette.background;
    icon: @image-url("../assets/app-icon.svg");
    min-width: 900px;
    min-height: 600px;

    in property <[DraftEntry]> documents;
    in property <string> selected-document-id;
    in property <[string]> line-labels;
    in-out property <int> selected-line: 0;
    private property <int> line-picker-index: 0;
    changed selected-line => { root.line-picker-index = root.selected-line; }
    in property <string> selected-name;
    in property <string> selected-path;
    in property <string> selected-hash;
    in property <string> source-text;
    in property <bool> source-has-xml;
    in property <string> recognition-text;
    in-out property <int> recognition-method: 0;
    in-out property <bool> recognition-running: false;
    in-out property <bool> ocr-enabled: true;
    in-out property <int> ocr-language: 0;
    in property <string> ocr-status;
    callback ocr-changed();
    callback start-recognition(bool);
    callback learn-corrections();
    in property <[string]> learning-profiles;
    in-out property <int> learning-profile-index: 0;
    in-out property <string> learning-name;
    in property <[LearningRuleData]> learning-rules;
    in property <bool> learning-can-undo;
    callback select-learning-profile();
    callback create-learning-profile();
    callback rename-learning-profile();
    callback delete-learning-profile();
    callback clear-learning-profile();
    callback undo-learning-profile();
    callback toggle-learning-rule(string);
    callback remove-learning-rule(string);
    callback recognition-method-changed();
    changed recognition-method => { root.recognition-method-changed(); }
    in-out property <string> company-name;
    in-out property <string> company-street;
    in-out property <string> company-postal;
    in-out property <string> company-city;
    in-out property <string> company-country;
    in-out property <string> company-vat;
    in-out property <string> company-tax-number;
    in-out property <string> company-endpoint;
    in-out property <string> company-contact-name;
    in-out property <string> company-contact-phone;
    in-out property <string> company-contact-email;
    in-out property <string> company-iban;
    in property <string> settings-status;
    callback save-settings();
    callback apply-company();
    in-out property <int> output-format: 0;
    callback recognize();
    in property <string> status-text;
    in property <string> app-version;
    in-out property <string> export-issue;
    in-out property <bool> export-review-required: false;
    in-out property <int> form-tab: 0;
    in-out property <int> invoice-kind: 0;
    in-out property <int> invoice-phase: 0;
    in-out property <string> service-date;
    in-out property <string> currency;
    in-out property <string> prepaid-amount;
    in-out property <string> payment-terms;
    in-out property <string> payment-bic;
    in-out property <string> payment-account;
    in-out property <string> payment-reference;
    in-out property <string> payment-means;
    in-out property <string> invoice-notes;
    in-out property <string> buyer-vat;
    in-out property <string> line-unit;
    in-out property <string> line-description;
    in-out property <string> line-tax-category;
    in-out property <string> line-tax-reason;
    in-out property <string> line-tax-reason-code;
    in-out property <[AdjustmentData]> document-adjustments;
    in-out property <[AdjustmentData]> line-adjustments;
    in-out property <[ReferenceData]> references;
    callback update-adjustment(bool, int, AdjustmentData);
    callback update-reference(int, ReferenceData);
    callback add-adjustment(bool);
    callback remove-adjustment(bool, int);
    callback add-reference();
    callback remove-reference(int);
    in-out property <string> invoice-number;
    in-out property <string> issue-date;
    in-out property <string> due-date;
    in-out property <string> buyer-reference;
    in-out property <string> seller-name;
    in-out property <string> seller-street;
    in-out property <string> seller-postal;
    in-out property <string> seller-city;
    in-out property <string> seller-country;
    in-out property <string> seller-vat;
    in-out property <string> seller-tax-number;
    in-out property <string> seller-endpoint;
    in-out property <string> seller-contact-name;
    in-out property <string> seller-contact-phone;
    in-out property <string> seller-contact-email;
    in-out property <string> buyer-name;
    in-out property <string> buyer-street;
    in-out property <string> buyer-postal;
    in-out property <string> buyer-city;
    in-out property <string> buyer-country;
    in-out property <string> buyer-endpoint;
    in-out property <string> line-name;
    in-out property <string> line-quantity;
    in-out property <string> line-price;
    in-out property <string> line-tax-rate;
    in-out property <string> payment-iban;
    in property <bool> iban-required: true;
    private property <bool> show-settings: false;
    out property <bool> settings-open: root.show-settings;
    out property <bool> sidebar-open: true;
    in-out property <int> settings-tab: 0;
    in property <image> preview-image;
    in property <float> preview-aspect: 1.414;
    in-out property <int> preview-page: 0;
    in property <int> preview-page-count: 0;
    in property <bool> preview-loading: false;
    in property <string> preview-error;
    in-out property <int> preview-zoom: 0;
    private property <float> preview-zoom-factor: root.preview-zoom == 1 ? 1.25 : root.preview-zoom == 2 ? 1.5 : root.preview-zoom == 3 ? 2 : 1;
    private property <length> preview-offset-x: 0px;
    private property <length> preview-offset-y: 0px;
    callback request-preview();
    changed selected-path => { root.preview-page = 0; root.preview-offset-x = 0px; root.preview-offset-y = 0px; root.request-preview(); }
    changed selected-hash => { root.request-preview(); }
    changed preview-page => { root.preview-offset-x = 0px; root.preview-offset-y = 0px; root.request-preview(); }
    changed preview-zoom => { root.preview-offset-x = 0px; root.preview-offset-y = 0px; root.request-preview(); }
    private property <bool> show-pdf-text: false;
    callback import-pdf();
    callback open-source();
    callback import-print-job();
    callback select-document(int);
    callback save-draft();
    callback save-output(bool);
    callback send-email();
    callback select-line(int);
    callback add-line();
    callback remove-line();

    VerticalBox {
        padding: 20px;
        spacing: 16px;

        HorizontalBox {
            spacing: 16px;
            Image { source: @image-url("../assets/app-icon.svg"); width: 40px; height: 40px; image-fit: contain; }
            if !root.show-settings : ActionButton {
                text: root.sidebar-open ? "Seitenleiste ausblenden" : "Seitenleiste einblenden";
                clicked => { root.sidebar-open = !root.sidebar-open; }
            }
            Rectangle { horizontal-stretch: 1; background: transparent; }

            ActionButton {
                icon: @image-url("../assets/settings.svg");
                height: 40px;
                accessible-label: "Einstellungen";
                width: 40px;
                clicked => { root.show-settings = !root.show-settings; }
            }
        }

        Rectangle {
        vertical-stretch: 1;
        min-width: 0px; min-height: 0px;
        preferred-width: 0px; preferred-height: 0px;
        if root.show-settings : Rectangle {
            width: parent.width; height: parent.height;
            background: Palette.alternate-background;
            border-radius: 8px;
            VerticalBox {
                padding: 24px;
                spacing: 16px;
                HorizontalBox {
                    Text { text: "Einstellungen"; font-size: 22px; font-weight: 600; horizontal-stretch: 1; }
                    ActionButton { text: "Zurück zur Rechnung"; clicked => { root.show-settings = false; } }
                }
                TabWidget {
                    current-index <=> root.settings-tab;
                    vertical-stretch: 1;
                    Tab {
                        title: "Unternehmen";
                        ScrollView {
                            VerticalBox {
                                padding: 16px; spacing: 10px; alignment: start;
                                Text { text: "Rechnungssteller"; font-size: 20px; font-weight: 600; }
                                Text { text: "Die Vorlage ergänzt fehlende Angaben in neuen Entwürfen. Bestehende Rechnungen bleiben erhalten."; wrap: word-wrap; }
                                LabeledField { label: "Unternehmen"; value <=> root.company-name; }
                                LabeledField { label: "Straße"; value <=> root.company-street; }
                                LabeledField { label: "PLZ"; value <=> root.company-postal; }
                                LabeledField { label: "Ort"; value <=> root.company-city; }
                                LabeledField { label: "Land (ISO)"; value <=> root.company-country; }
                                LabeledField { label: "USt-ID"; value <=> root.company-vat; }
                                LabeledField { label: "Steuernummer"; value <=> root.company-tax-number; }
                                LabeledField { label: "E-Adresse"; value <=> root.company-endpoint; }
                                LabeledField { label: "Kontakt"; value <=> root.company-contact-name; }
                                LabeledField { label: "Telefon"; value <=> root.company-contact-phone; }
                                LabeledField { label: "E-Mail"; value <=> root.company-contact-email; }
                                LabeledField { label: "IBAN"; value <=> root.company-iban; }
                            }
                        }
                    }
                    Tab {
                        title: "Allgemein";
                        VerticalBox {
                            padding: 16px; spacing: 16px; alignment: start;
                            Text { text: "Darstellung"; font-size: 18px; font-weight: 600; }
                            ComboBox { max-width: 320px; model: ["System", "Hell", "Dunkel"]; current-index <=> root.appearance; }
                            Text { text: "Die Darstellung wird automatisch gespeichert."; wrap: word-wrap; }
                        }
                    }
                    Tab {
                        title: "Erkennung";
                        ScrollView {
                            VerticalBox { padding: 16px; spacing: 12px; alignment: start;
                            Text { text: "Erkennungsmodus"; font-size: 18px; font-weight: 600; }
                            ComboBox { max-width: 420px; model: ["Schemaerkennung", "Lokale KI (noch nicht installiert)"]; current-index <=> root.recognition-method; enabled: !OutputState.busy; }
                            Text { text: "Die Auswahl gilt für neue Importe und die erneute Erkennung. Der lokale KI-Adapter ist noch nicht installiert."; wrap: word-wrap; }
                            Text { text: "Erkennungsmodus und OCR-Einstellungen werden automatisch gespeichert."; wrap: word-wrap; }

                                Text { text: "Scans / OCR"; font-size: 18px; font-weight: 600; }
                                CheckBox { text: "Textarme PDF-Seiten automatisch lokal erkennen"; checked <=> root.ocr-enabled; enabled: !OutputState.busy; toggled => { root.ocr-changed(); } }
                                ComboBox { model: ["Deutsch + Englisch", "Deutsch", "Englisch"]; current-index <=> root.ocr-language; enabled: !OutputState.busy; selected => { root.ocr-changed(); } }
                                Text { text: root.ocr-status; wrap: word-wrap; }
                                Text { text: "OCR ergänzt PDF-Text bei Scans. Das Original bleibt unverändert. Zahlen und Positionen bitte am Beleg prüfen."; wrap: word-wrap; }
                                Text { text: "Lernprofile"; font-size: 18px; font-weight: 600; }
                                ComboBox { model: root.learning-profiles; current-index <=> root.learning-profile-index; enabled: !OutputState.busy; selected => { root.select-learning-profile(); } }
                                LabeledField { label: "Profilname"; value <=> root.learning-name; }
                                HorizontalBox { padding: 0px;
                                    ActionButton { text: "Neues Profil"; enabled: !OutputState.busy; clicked => { root.create-learning-profile(); } }
                                    ActionButton { text: "Umbenennen"; enabled: !OutputState.busy; clicked => { root.rename-learning-profile(); } }
                                    ActionButton { text: "Profil löschen"; enabled: !OutputState.busy && root.learning-profiles.length > 1; clicked => { root.delete-learning-profile(); } }
                                }
                                Text { text: "Nach dem Korrigieren unter Erkennung auf ‚Aus Korrekturen lernen‘ klicken. Das Profil lernt Fundstellen und Tabellenspalten für ähnliche Belege, keine festen Rechnungsnummern oder Datumswerte."; wrap: word-wrap; }
                                HorizontalBox { padding: 0px;
                                    ActionButton { text: "Regeln leeren"; enabled: !OutputState.busy && root.learning-rules.length > 0; clicked => { root.clear-learning-profile(); } }
                                    ActionButton { text: "Rückgängig"; enabled: !OutputState.busy && root.learning-can-undo; clicked => { root.undo-learning-profile(); } }
                                }
                                if root.learning-rules.length == 0 : Text { text: "In diesem Profil sind noch keine Fundstellen gelernt."; }
                                for rule in root.learning-rules : HorizontalBox {
                                    padding: 0px;
                                    Text { text: rule.label + (rule.enabled ? "" : " · deaktiviert"); wrap: word-wrap; horizontal-stretch: 1; }
                                    ActionButton { text: rule.enabled ? "Deaktivieren" : "Aktivieren"; enabled: !OutputState.busy; clicked => { root.toggle-learning-rule(rule.id); } }
                                    ActionButton { text: "Entfernen"; enabled: !OutputState.busy; clicked => { root.remove-learning-rule(rule.id); } }
                                }
                            }
                        }
                    }
                    Tab {
                        title: "Über";
                        VerticalBox {
                            padding: 16px; spacing: 16px; alignment: start;
                            Text { text: "Über Druckwandel"; font-size: 20px; font-weight: 600; }
                            Text { text: "Version " + root.app-version; }
                            AboutSlint { max-width: 420px; max-height: 220px; }
                        }
                    }
                }
                if root.settings-tab == 0 : HorizontalBox {
                    ActionButton { text: "Unternehmensdaten speichern"; primary: true; enabled: !OutputState.busy; clicked => { root.save-settings(); } }
                    ActionButton { text: "In aktuelle Rechnung übernehmen"; enabled: root.selected-name != "" && !OutputState.busy; clicked => { root.apply-company(); } }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                }
                Text { text: root.settings-status; wrap: word-wrap; }
            }
        }

        if !root.show-settings : HorizontalBox {
            width: parent.width; height: parent.height;
            spacing: 16px;
            if root.sidebar-open : Rectangle {
                width: max(160px, min(240px, root.width * 0.16));
                background: Palette.alternate-background;
                border-radius: 8px;
                VerticalBox {
                    padding: 12px;
                    spacing: 8px;
                    ActionButton { text: "Neue PDF öffnen"; primary: true; enabled: !OutputState.busy; clicked => { root.import-pdf(); } }
                    ActionButton { text: "Druckeingang"; enabled: !OutputState.busy; clicked => { root.import-print-job(); } }
                    Text { text: "Entwürfe"; font-size: 18px; font-weight: 600; }
                    ScrollView {
                        vertical-stretch: 1;
                        VerticalBox {
                            padding: 0px;
                            alignment: start;
                            spacing: 4px;
                            for document[index] in root.documents : ActionButton {
                                text: document.name;
                                primary: document.id == root.selected-document-id;
                                selected: document.id == root.selected-document-id;
                                height: 36px;
                                enabled: !OutputState.busy; clicked => { root.select-document(index); }
                            }
                        }
                    }
                }
            }
            if root.selected-name == "" : Rectangle {
                background: Palette.alternate-background;
                border-radius: 8px;
                horizontal-stretch: 1;
                VerticalBox {
                    padding: 32px;
                    alignment: center;
                    spacing: 18px;
                    Text { text: "Rechnung öffnen und prüfen"; font-size: 24px; font-weight: 600; }
                    Text { text: "1. In der Seitenleiste eine PDF öffnen oder einen Entwurf auswählen.\n2. Erkannte Rechnungsdaten mit dem Original vergleichen.\n3. Ausgabe prüfen, speichern und per E-Mail teilen."; wrap: word-wrap; }
                }
            }
            if root.selected-name != "" : Rectangle {
                min-width: 240px;
                horizontal-stretch: 1;
                background: Palette.alternate-background;
                border-radius: 8px;
                VerticalBox {
                    padding: 12px;
                    spacing: 8px;
                    Text { text: root.selected-name; font-size: 18px; font-weight: 600; wrap: word-wrap; }
                    TabWidget {
                        vertical-stretch: 1;
                        Tab {
                            title: "PDF-Vorschau";
                            VerticalBox {
                                spacing: 8px;
                                HorizontalBox {
                                    padding: 0px;
                                    spacing: 4px;
                                    ActionButton { text: "‹"; accessible-label: "Vorherige Seite"; enabled: root.preview-page > 0; clicked => { root.preview-page -= 1; } }
                                    Text {
                                        text: root.preview-page-count > 0 ? (root.preview-page + 1) + " / " + root.preview-page-count : "PDF";
                                        accessible-label: root.preview-page-count > 0 ? "Seite " + self.text : self.text;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                    ActionButton { text: "›"; accessible-label: "Nächste Seite"; enabled: root.preview-page + 1 < root.preview-page-count; clicked => { root.preview-page += 1; } }
                                    ComboBox { min-width: 112px; model: ["Seitenbreite", "125 %", "150 %", "200 %"]; current-index <=> root.preview-zoom; }
                                }
                                if root.preview-loading : Text { text: "Seite wird gerendert …"; }
                                if root.preview-error != "" : Text { text: root.preview-error; wrap: word-wrap; }
                                preview-scroll := ScrollView {
                                    vertical-stretch: 1;
                                    viewport-x <=> root.preview-offset-x;
                                    viewport-y <=> root.preview-offset-y;
                                    viewport-width: max(self.visible-width, page-image.width + 16px);
                                    viewport-height: page-image.height + 16px;
                                    Rectangle {
                                        x: 0px; y: 0px;
                                        width: preview-scroll.viewport-width;
                                        height: preview-scroll.viewport-height;
                                        background: #686b70;
                                        page-image := Image {
                                            x: 8px; y: 8px;
                                            width: max(100px, (preview-scroll.visible-width - 16px) * root.preview-zoom-factor);
                                            height: self.width * root.preview-aspect;
                                            source: root.preview-image;
                                            image-fit: contain;
                                            accessible-label: "Gerenderte Original-PDF, Seite " + (root.preview-page + 1);
                                        }
                                    }
                                }
                            }
                        }
                        Tab {
                            title: "Erkennung";
                            VerticalBox {
                                spacing: 10px;
                                if root.source-has-xml : Text {
                                    text: "ZUGFeRD-XML vorhanden. Der aktuelle Import übernimmt nur PDF-Textvorschläge, noch nicht die eingebetteten Rechnungsdaten.";
                                    wrap: word-wrap;
                                }
                                ActionButton { text: "Aus Korrekturen lernen"; enabled: !OutputState.busy; clicked => { root.learn-corrections(); } }
                                ActionButton { text: "Fehlende Felder erkennen"; enabled: !OutputState.busy; clicked => { root.recognize(); } }
                                TextEdit { text: root.recognition-text; read-only: true; vertical-stretch: 1; }
                                ActionButton { text: root.show-pdf-text ? "PDF-Text ausblenden" : "PDF-Text anzeigen"; clicked => { root.show-pdf-text = !root.show-pdf-text; } }
                                if root.show-pdf-text : TextEdit { text: root.source-text; read-only: true; vertical-stretch: 1; }
                            }
                        }
                    }
                }
            }
            if root.selected-name != "" : Rectangle {
                min-width: 340px;
                background: Palette.alternate-background;
                border-radius: 8px;
                horizontal-stretch: 1;
                VerticalBox {
                padding: 12px; spacing: 10px;
                GridLayout {
                vertical-stretch: 1;
                min-height: 0px;
                preferred-height: 0px;
                TabWidget {
                    row: 0; col: 0;
                    visible: root.export-issue == "";
                    current-index <=> root.form-tab;
                    vertical-stretch: 1;
                    Tab { title: "Rechnung";
                        ScrollView {
                            VerticalBox { padding: 16px; spacing: 8px; alignment: start;
                        Text { text: "Rechnungsdaten"; font-size: 20px; font-weight: 600; }
                        LabeledField { label: "Rechnungsnummer"; value <=> root.invoice-number; required: true; }
                        LabeledField { label: "Rechnungsdatum"; value <=> root.issue-date; required: true; }
                        LabeledField { label: "Fälligkeit"; value <=> root.due-date; }
                        LabeledField { label: "Leitweg-ID/Referenz"; value <=> root.buyer-reference; required: root.output-format == 1; }

                        LabeledField { label: "Leistungsdatum"; value <=> root.service-date; }
                        Text { text: "Datumsangaben: JJJJ-MM-TT"; wrap: word-wrap; }
                        LabeledField { label: "Währung (ISO)"; value <=> root.currency; required: true; }
                        Text { text: "Rechnungsart"; font-weight: 600; }
                        ComboBox {
                            model: ["Rechnung (380)", "Gutschrift (381)", "Korrekturrechnung (384)", "Teilrechnung (326)"];
                            current-index <=> root.invoice-kind; enabled: !OutputState.busy;
                            selected => { if root.invoice-kind != 0 { root.invoice-phase = 0; } OutputState.can-email = false; }
                        }
                        ComboBox {
                            model: ["Keine Anzahlung / Schlussrechnung", "Anzahlungsrechnung", "Schlussrechnung"];
                            current-index <=> root.invoice-phase; enabled: !OutputState.busy;
                            selected => { if root.invoice-phase != 0 { root.invoice-kind = 0; } OutputState.can-email = false; }
                        }
                        LabeledField { label: "Bereits gezahlt"; value <=> root.prepaid-amount; }
                        Text { text: "Ohne Gesamtbetrag werden die Zahlungen aus den Rechnungsbezügen verwendet. Bezüge und Rabatte stehen unter Details."; wrap: word-wrap; }
                        Text { text: "Absender"; font-size: 16px; font-weight: 600; }
                        LabeledField { label: "Name"; value <=> root.seller-name; required: true; }
                        LabeledField { label: "Straße"; value <=> root.seller-street; required: true; }
                        LabeledField { label: "PLZ"; value <=> root.seller-postal; required: true; }
                        LabeledField { label: "Ort"; value <=> root.seller-city; required: true; }
                        LabeledField { label: "Land (ISO)"; value <=> root.seller-country; required: true; }
                        LabeledField { label: "USt-ID"; value <=> root.seller-vat; required: FieldRules.is-blank(root.seller-tax-number); }
                        LabeledField { label: "Steuernummer"; value <=> root.seller-tax-number; }
                        LabeledField { label: "E-Adresse"; value <=> root.seller-endpoint; required: root.output-format == 1; }
                        LabeledField { label: "Kontakt"; value <=> root.seller-contact-name; required: root.output-format == 1; }
                        LabeledField { label: "Telefon"; value <=> root.seller-contact-phone; required: root.output-format == 1; }
                        LabeledField { label: "E-Mail"; value <=> root.seller-contact-email; required: root.output-format == 1; }
                        Text { text: "Empfänger"; font-size: 16px; font-weight: 600; }
                        LabeledField { label: "Name"; value <=> root.buyer-name; required: true; }
                        LabeledField { label: "Straße"; value <=> root.buyer-street; required: true; }
                        LabeledField { label: "PLZ"; value <=> root.buyer-postal; required: true; }
                        LabeledField { label: "Ort"; value <=> root.buyer-city; required: true; }
                        LabeledField { label: "Land (ISO)"; value <=> root.buyer-country; required: true; }
                        LabeledField { label: "USt-ID"; value <=> root.buyer-vat; }
                        LabeledField { label: "E-Adresse"; value <=> root.buyer-endpoint; required: root.output-format == 1; }
                        Text { text: "Zahlung"; font-size: 16px; font-weight: 600; }
                        LabeledField { label: "IBAN"; value <=> root.payment-iban; required: root.payment-means == "30" || root.payment-means == "58" || root.payment-means == "59"; }
                        LabeledField { label: "Zahlungsart (Code)"; value <=> root.payment-means; required: true; }
                        Text { text: "58 = SEPA-Überweisung, 30 = Überweisung, 10 = Barzahlung"; wrap: word-wrap; }
                        LabeledField { label: "BIC"; value <=> root.payment-bic; }
                        LabeledField { label: "Kontoinhaber"; value <=> root.payment-account; }
                        LabeledField { label: "Verwendungszweck"; value <=> root.payment-reference; }
                        LabeledField { label: "Zahlungsbedingungen"; value <=> root.payment-terms; }
                        Text { text: "Rechnungshinweise (ein Hinweis je Zeile)"; }
                        TextEdit { text <=> root.invoice-notes; min-height: 90px; enabled: !OutputState.busy; edited => { OutputState.can-email = false; } }

                            }
                        }
                    }
                    Tab { title: "Positionen";
                        ScrollView {
                            VerticalBox { padding: 16px; spacing: 8px; alignment: start;
                        HorizontalBox {
                            padding: 0px;
                            spacing: 8px;
                            ComboBox {
                                accessible-label: "Rechnungsposition auswählen";
                                model: root.line-labels;
                                current-index <=> root.line-picker-index;
                                enabled: !OutputState.busy;
                                selected => { root.select-line(self.current-index); }
                            }
                            ActionButton { text: "+"; accessible-label: "Position hinzufügen"; enabled: !OutputState.busy; clicked => { root.add-line(); } }
                            ActionButton { text: "−"; accessible-label: "Aktuelle Position entfernen"; enabled: root.line-labels.length > 1 && !OutputState.busy; clicked => { root.remove-line(); } }
                        }
                        LabeledField { label: "Bezeichnung"; value <=> root.line-name; required: true; }
                        LabeledField { label: "Menge"; value <=> root.line-quantity; required: true; }
                        LabeledField { label: "Nettopreis"; value <=> root.line-price; required: true; }
                        LabeledField { label: "Einheit (Code)"; value <=> root.line-unit; required: true; }
                        Text { text: "C62 = Stück, HUR = Stunde, MTR = Meter, KGM = Kilogramm"; wrap: word-wrap; }
                        LabeledField { label: "Beschreibung"; value <=> root.line-description; }
                        TaxFields { category <=> root.line-tax-category; rate <=> root.line-tax-rate; reason <=> root.line-tax-reason; reason-code <=> root.line-tax-reason-code; }
                        Text { text: "Rabatte / Zuschläge dieser Position"; font-size: 16px; font-weight: 600; }
                        Text { text: "Der Nettobetrag gilt für die gesamte Position. Prozent und Basisbetrag beschreiben den Betrag; sie ersetzen ihn nicht."; wrap: word-wrap; }
                        for adjustment[index] in root.line-adjustments : AdjustmentEditor {
                            item: adjustment; line-level: true;
                            edited(value) => { root.update-adjustment(true, index, value); }
                            remove => { root.remove-adjustment(true, index); }
                        }
                        ActionButton { text: "Rabatt / Zuschlag hinzufügen"; enabled: !OutputState.busy; clicked => { root.add-adjustment(true); } }


                            }
                        }
                    }
                    Tab { title: "Details";
                        ScrollView {
                            VerticalBox { padding: 16px; spacing: 8px; alignment: start;

                        Text { text: "Rabatte / Zuschläge der Rechnung"; font-size: 18px; font-weight: 600; }
                        Text { text: "Nettobeträge in der Rechnungswährung. Prozent und Basisbetrag sind optionale Angaben zum eingegebenen Betrag."; wrap: word-wrap; }
                        for adjustment[index] in root.document-adjustments : AdjustmentEditor {
                            item: adjustment;
                            edited(value) => { root.update-adjustment(false, index, value); }
                            remove => { root.remove-adjustment(false, index); }
                        }
                        ActionButton { text: "Rabatt / Zuschlag hinzufügen"; enabled: !OutputState.busy; clicked => { root.add-adjustment(false); } }
                        Text { text: "Bezüge auf frühere Rechnungen"; font-size: 18px; font-weight: 600; }
                        if (root.invoice-kind == 1 || root.invoice-kind == 2 || root.invoice-phase == 2) && root.references.length == 0 : Text {
                            text: "Bitte mindestens einen Bezug zur Ursprungsrechnung hinzufügen."; color: #d54444; wrap: word-wrap;
                        }
                        for reference[index] in root.references : ReferenceEditor {
                            item: reference;
                            edited(value) => { root.update-reference(index, value); }
                            remove => { root.remove-reference(index); }
                        }
                        ActionButton { text: "Rechnungsbezug hinzufügen"; enabled: !OutputState.busy; clicked => { root.add-reference(); } }

                            }
                        }
                    }
                }
                if root.export-issue != "" : Rectangle {
                    row: 0; col: 0;
                    background: Palette.background;
                    border-color: Palette.border;
                    border-width: 1px;
                    border-radius: 6px;
                    VerticalBox {
                        padding: 8px; spacing: 8px;
                        HorizontalBox {
                            padding: 0px;
                            Text { text: "Ausgabe prüfen"; font-size: 16px; font-weight: 600; vertical-alignment: center; horizontal-stretch: 1; }
                            ActionButton {
                                text: "Zum Formular";
                                clicked => { root.export-issue = ""; root.export-review-required = false; }
                            }
                        }
                        ScrollView {
                            vertical-stretch: 1;
                            VerticalBox {
                                padding: 4px;
                                Text { text: root.export-issue; wrap: word-wrap; }
                            }
                        }
                        if root.export-review-required : ActionButton {
                            text: "Abweichung geprüft – weiter";
                            primary: true;
                            clicked => { root.save-output(true); }
                        }
                    }
                }
                }
                Text { text: "* Pflichtfeld · rot markierte Felder bitte ausfüllen"; wrap: word-wrap; }
                ComboBox { model: ["ZUGFeRD (PDF)", "XRechnung (XML)"]; current-index <=> root.output-format; enabled: !OutputState.busy; selected => { OutputState.can-email = false; } }
                HorizontalBox {
                    padding: 0px;
                    spacing: 8px;
                    ActionButton { text: "Entwurf speichern"; enabled: !OutputState.busy; clicked => { root.save-draft(); } }
                    ActionButton { text: "Prüfen und speichern"; primary: true; enabled: !OutputState.busy; clicked => { root.save-output(false); } }
                }
                HorizontalBox {
                    padding: 0px;
                    spacing: 8px;
                    ActionButton { text: "PDF öffnen"; enabled: !OutputState.busy; clicked => { root.open-source(); } }
                    ActionButton { text: "Per E-Mail senden"; enabled: OutputState.can-email && !OutputState.busy; clicked => { root.send-email(); } }
                }
                }
            }
        }
        }

        Text {
            text: root.recognition-running ? "Lokale Erkennung / Lernen läuft …" : root.status-text;
            color: Palette.foreground;
            wrap: word-wrap;
        }
    }
}
