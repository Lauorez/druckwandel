{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-review-window",
  "description": "Minimal IPC permissions for the E-Rechnungs-Assistent main window.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-destroy",
    "core:window:allow-close",
    "deep-link:default"
  ]
}
